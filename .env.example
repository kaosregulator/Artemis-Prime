# Artemis Prime — environment variables
#
# Copy the values you need into your Railway or Northflank service Variables /
# Secret group (or into a local `.env` for development). Do NOT commit real secrets.
#
# See also:
#   docs/RAILWAY.md
#   docs/NORTHFLANK.md
#
# ── Required (the server refuses to boot without these) ─────────────────────

# Postgres connection string.
# Railway: add a Postgres database and reference it:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
# Northflank: link the Postgres addon POSTGRES_URI into a secret group with
# alias DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign session cookies. Use a long random string, e.g.:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ── Provided automatically in production ────────────────────────────────────

# Port the server listens on. Railway injects this automatically. The Dockerfile
# defaults it to 8080 (also what Northflank should target as the internal HTTP
# port). You normally do NOT need to set this unless pinning for Northflank.
# PORT=8080

# The Docker image already sets NODE_ENV=production. Only override for local dev.
# NODE_ENV=production

# ── Discord (required for login and the bot to work) ────────────────────────

DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
DISCORD_BOT_TOKEN=your-discord-bot-token

# OAuth callback URL. If left unset the app derives it from the incoming request
# host, which works out of the box on Railway and Northflank. Pin it to your
# stable domain in production so it can never drift:
#   https://<your-app>.up.railway.app/api/auth/callback
#   https://<port>--<service>--<id>.code.run/api/auth/callback
# This exact URL must also be added under OAuth2 → Redirects in the Discord
# Developer Portal.
# DISCORD_REDIRECT_URI=https://your-app.up.railway.app/api/auth/callback

# ── Optional ────────────────────────────────────────────────────────────────

# Optional: comma-separated guild IDs for INSTANT slash updates in those servers.
# Global registration always runs. If Discord returns Missing Access (50001),
# delete this variable or re-invite the bot with the applications.commands scope.
# DISCORD_DEV_GUILD_ID=

# Pino log level: trace | debug | info | warn | error | fatal (default: info)
# LOG_LEVEL=info

# Development-only: the bot is skipped when NODE_ENV=development unless this is
# set to "true". It has no effect in production.
# DISCORD_BOT_ENABLED=true

# ── Roblox (optional) ───────────────────────────────────────────────────────

# Open Cloud API key — ONLY needed for authenticated Open Cloud features
# (DataStores, Messaging, etc.). All /roblox and /military hub commands use
# public Roblox APIs and work without this key. Do NOT use .ROBLOSECURITY cookies.
# ROBLOX_CLOUD_KEY=
# Never set ROBLOX_COOKIE / .ROBLOSECURITY — this bot refuses cookie auth.

# ── Game Intelligence / Bloxscout (optional) ────────────────────────────────
# Local SQLite snapshot DB for historical CCU/visits (defaults to ./data/bloxscout/data.db).
# BLOXSCOUT_DATA_DIR=
# BLOXSCOUT_DB_PATH=
# Auto-snapshot interval in seconds for Military Tycoon (min 60, default 900).
# BLOXSCOUT_SNAPSHOT_INTERVAL_SEC=900
